/run.pid

# macOS / Windows служебные файлы
.DS_Store
Thumbs.db

# Cargo.lock комментарий:
# Для БИНАРНОГО приложения Cargo.lock следует КОММИТИТЬ (точно воспроизводимая
# сборка). Правило «не коммитить Cargo.lock» действует только для библиотек.
# Поэтому Cargo.lock НЕ игнорируется.

