# Rust
/target/

# Временные папки компилятора (cc temp-файлы)
/.buildtmp/
/.build-tmp/

# Частично скачанные файлы
*.part

# Python (на случай вспомогательных скриптов)
__pycache__/
*.pyc

# Логи (например, логи лаунчера в папке «кот»)
кота/**/*.log
кот/**/*.log

# Сигналы запуска/паник лаунчера в корне проекта
/limecraft_start.log
/limecraft_panic.log
/run.stdout.log
/run.stderr.log
/run.pid

# macOS / Windows служебные файлы
.DS_Store
Thumbs.db

# Cargo.lock комментарий:
# Для БИНАРНОГО приложения Cargo.lock следует КОММИТИТЬ (точно воспроизводимая
# сборка). Правило «не коммитить Cargo.lock» действует только для библиотек.
# Поэтому Cargo.lock НЕ игнорируется.
